{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@microsoft/sp-http": ["src/shims/sp-http"],
      "@microsoft/sp-webpart-base": ["src/shims/sp-webpart-base"]
    }
  },
  "include": ["src"]
}

