{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "jsx": "react",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "react": ["standalone-app/node_modules/react"],
      "react/jsx-runtime": ["standalone-app/node_modules/react/jsx-runtime"],
      "react-dom": ["standalone-app/node_modules/react-dom"],
      "@fluentui/react": ["standalone-app/node_modules/@fluentui/react"]
    }
  },
  "include": [
    "mongo-server/**/*.ts",
    "webparts/**/*.ts",
    "webparts/**/*.tsx",
    "types/**/*.d.ts"
  ]
}
