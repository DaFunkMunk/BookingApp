MONGODB_URI=mongodb+srv://app_user:AppUser2025Test@bookingappcluster.t1kyqjv.mongodb.net/bookingapp?retryWrites=true&w=majority&appName=BookingAppCluster&authSource=admin

# API server port (used by mongo-server/server.ts)
PORT=4000
HTTPS_PORT=4001

# Local HTTPS certs for the API (enable https://localhost:4001)
# Generate with mkcert and adjust paths if needed
TLS_CERT_PATH=mongo-server/certs/localhost.pem
TLS_KEY_PATH=mongo-server/certs/localhost-key.pem
